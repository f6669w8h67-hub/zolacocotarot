# 從 Vercel 專案的 Storage > Postgres 建立資料庫後,連結專案會自動注入這個變數。
# 本機開發時,把 Vercel 專案設定裡的值複製過來,或使用你自己的 Postgres 連線字串。
DATABASE_URL=postgresql://user:password@host:5432/dbname

# NextAuth 用來加密 session/JWT 的密鑰,可用指令產生: npx auth secret
AUTH_SECRET=

# 這個 Email 註冊時會自動被設為管理員(可以看到 /admin 後台)
ADMIN_EMAIL=you@example.com
